# Agent Trust Plane — gateway configuration
# Copy to .env and adjust. All values have safe local defaults.

# Generate both with:  uv run python -m atp_gateway keygen
# A persistent gateway REFUSES TO START without them (>= 32 characters each).
# Only ATP_DATABASE_PATH=:memory: generates per-process keys.

# HMAC key for execution grants.
ATP_GRANT_SIGNING_KEY=

# Operator key: issues agent credentials, delegates human authority, selects
# non-default policy sets, runs evals, reads traces/ledger. Agents never hold it.
# The dashboard asks for it; the eval CLI reads $ATP_OPERATOR_KEY.
ATP_OPERATOR_KEY=

# Seconds an execution grant stays valid after /authorize returns ALLOW.
ATP_GRANT_TTL_SECONDS=120

# SQLite path. Use ":memory:" for an ephemeral store.
ATP_DATABASE_PATH=./data/atp.db

# Comma-separated origins allowed to call the gateway from a browser.
ATP_CORS_ORIGINS=http://localhost:3000

# Optional: enable the real-LLM agent in examples/finance-agent.
# Leave unset to use the deterministic SimulatedAgent (the default and what the
# evals use).
ANTHROPIC_API_KEY=
